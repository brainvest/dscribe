{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-host",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/server/Host/Host.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "publish-host",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/server/Host/Host.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch-host",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"${workspaceFolder}/server/Host/Host.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build-auth",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/server/Infrastructure/SampleAuthServer/SampleAuthServer.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish-auth",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/server/Infrastructure/SampleAuthServer/SampleAuthServer.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch-auth",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"${workspaceFolder}/server/Infrastructure/SampleAuthServer/SampleAuthServer.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			// Used by the "LaunchAll+TestUI" launch configuration: waits until the auth server, the Host and the
			// client accept connections, so the Playwright UI reuses them instead of starting its own.
			"label": "wait-for-servers",
			"type": "shell",
			"command": "node e2e/support/wait-for-servers.mjs",
			"options": {"cwd": "${workspaceFolder}/client"},
			"presentation": {"reveal": "silent"},
			"problemMatcher": []
		}
	]
}
