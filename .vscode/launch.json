{
	// Use IntelliSense to find out which attributes exist for C# debugging
	// Use hover for the description of the existing attributes
	// For further information visit https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Host",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build-host",
			// If you have changed target frameworks, make sure to update the program path.
			"program": "${workspaceFolder}/server/Host/bin/Debug/net10.0/Brainvest.Dscribe.Host.dll",
			"args": [],
			"cwd": "${workspaceFolder}/server/Host",
			"stopAtEntry": false,
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			},
			"sourceFileMap": {
				"/Views": "${workspaceFolder}/server/Views"
			}
		},
		{
			"name": "Auth",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build-auth",
			// If you have changed target frameworks, make sure to update the program path.
			"program": "${workspaceFolder}/server/Infrastructure/SampleAuthServer/bin/Debug/net10.0/Brainvest.Dscribe.Infrastructure.SampleAuthServer.dll",
			"args": [],
			"cwd": "${workspaceFolder}/server/Infrastructure/SampleAuthServer",
			"stopAtEntry": false,
			// Enable launching a web browser when ASP.NET Core starts. For more information: https://aka.ms/VSCode-CS-LaunchJson-WebBrowser
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "^\\s*Now listening on:\\s+(https?://\\S+)"
			},
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			},
			"sourceFileMap": {
				"/Views": "${workspaceFolder}/server/Views"
			}
		},
		{
			"name": ".NET Core Attach",
			"type": "coreclr",
			"request": "attach",
			"processId": "${command:pickProcess}"
		},
		// The four entries below are parts of the "LaunchAll+TestUI" compound.
		{
			// Same as "Host", with the settings the e2e suite expects (see client/playwright.config.ts).
			"name": "Host (e2e)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build-host",
			"program": "${workspaceFolder}/server/Host/bin/Debug/net10.0/Brainvest.Dscribe.Host.dll",
			"args": [],
			"cwd": "${workspaceFolder}/server/Host",
			"stopAtEntry": false,
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_URLS": "http://localhost:5000",
				// The checked-in settings point at a Linux home directory.
				"GlobalConfiguration__ImplementationsDirectory": "${workspaceFolder}/client/e2e/.implementations",
				"GlobalConfiguration__TempDirectory": "${workspaceFolder}/client/e2e/.implementations"
			}
		},
		{
			// Test-only auth server on :5001 (login e2e-admin / e2e-password), not the real SampleAuthServer.
			"name": "Auth (fake)",
			"type": "node-terminal",
			"request": "launch",
			"command": "node e2e/support/fake-auth-server.mjs",
			"cwd": "${workspaceFolder}/client"
		},
		{
			"name": "Client",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm start",
			"cwd": "${workspaceFolder}/client"
		},
		{
			"name": "Test UI",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm e2e:ui",
			"cwd": "${workspaceFolder}/client",
			"preLaunchTask": "wait-for-servers"
		}
	],
	"compounds": [
		{
			"name": "Launch All",
			"configurations": [
				"Host",
				"Auth"
			]
		},
		{
			// Backend + fake auth + frontend, then the Playwright UI once all three are up.
			"name": "LaunchAll+TestUI",
			"configurations": [
				"Host (e2e)",
				"Auth (fake)",
				"Client",
				"Test UI"
			],
			"stopAll": true
		}
	]
}
