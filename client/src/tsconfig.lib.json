{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../out-tsc/lib",
    "declarationMap": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "importHelpers": true,
    "types": [],
    "lib": [
      "dom",
      "es2017"
    ]
  },
  "angularCompilerOptions": {
    "compilationMode": "full"
  },
  "exclude": [
    "test.ts",
    "**/*.spec.ts"
  ]
}
