{
  "name": "@waltzar/client-workspace",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @waltzar/angular-app start",
    "build": "pnpm --filter @waltzar/angular-app build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
